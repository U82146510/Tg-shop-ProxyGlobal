<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Metrics Dashboard</title>
    <link rel="stylesheet" href="/admin/metrics.css">
</head>
<body>

<nav class="nav">
    <ul>
        <li><a href="/admin/users">Dashboard</a></li>
        <li><a href="/admin/user">User</a></li>
        <li><a href="/admin/logs">User Logs</a></li>
        <li><a href="/admin/userupdate">User Update</a></li>
        <li><a href="/admin/product">Products</a></li>
        <li><a href="/admin/statistics">Statistics</a></li>
        <li><a href="/admin/update">Settings</a></li>
        <li><a href="/admin/sendmessage">Send Message</a></li>
        <li><a href="/admin/promocode">Promocode</a></li>
        <li><a href="/admin/options">Shop Settings</a></li>
        <li><a href="/admin/metrics">Metrics</a></li>
        <li><a href="/admin/logout">Logout</a></li>
    </ul>
</nav>

<div class="metrics-container">
    <h1>Visitor Metrics Dashboard</h1>

    <!-- Summary Cards -->
    <div class="summary-cards">
        <div class="card">
            <h3>Total Visits (All Time)</h3>
            <p class="stat-value"><%= totalVisits %></p>
        </div>
        <div class="card">
            <h3>Today's Visits</h3>
            <p class="stat-value"><%= todayVisits %></p>
        </div>
    </div>

    <!-- Device Breakdown -->
    <div class="section">
        <h2>Devices Used</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Device Type</th>
                    <th>Total Visits</th>
                </tr>
            </thead>
            <tbody>
                <% if (deviceBreakdown && deviceBreakdown.length > 0) { %>
                    <% deviceBreakdown.forEach(device => { %>
                        <tr>
                            <td><%= device.device || 'Unknown' %></td>
                            <td><%= device.totalVisits %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="2">No data available</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Browser Breakdown -->
    <div class="section">
        <h2>Browsers Used</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Browser</th>
                    <th>Total Visits</th>
                </tr>
            </thead>
            <tbody>
                <% if (browserBreakdown && browserBreakdown.length > 0) { %>
                    <% browserBreakdown.forEach(browser => { %>
                        <tr>
                            <td><%= browser.browser || 'Unknown' %></td>
                            <td><%= browser.totalVisits %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="2">No data available</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Country Breakdown -->
    <div class="section">
        <h2>Countries</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Country Code</th>
                    <th>Total Visits</th>
                </tr>
            </thead>
            <tbody>
                <% if (countryBreakdown && countryBreakdown.length > 0) { %>
                    <% countryBreakdown.forEach(country => { %>
                        <tr>
                            <td><%= country.country || 'Unknown' %></td>
                            <td><%= country.totalVisits %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="2">No data available</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Last 30 IPs Today -->
    <div class="section">
        <h2>Last 30 IP Addresses (Today)</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>IP Address</th>
                    <th>Timestamp</th>
                </tr>
            </thead>
            <tbody>
                <% if (last30IPsToday && last30IPsToday.length > 0) { %>
                    <% last30IPsToday.forEach(ip => { %>
                        <tr>
                            <td><%= ip.ipAddress %></td>
                            <td><%= new Date(ip.timestamp).toLocaleString() %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="2">No data available</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

</div>

<% if (error) { %>
    <p class="error"><%= error %></p>
<% } %>
</body>
</html>
</div>

</body>
</html>
